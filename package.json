{
  "name": "sideline",
  "version": "1.0.0",
  "description": "Sideline - a gameday fantasy companion for Sleeper and ESPN",
  "main": "./out/main/index.js",
  "author": "Kevin Etheridge",
  "homepage": "https://github.com/ketheridge7/sideline",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "replay": "cross-env SIDELINE_REPLAY=1 electron-vite dev",
    "replay:capture": "cross-env SIDELINE_REPLAY=1 SIDELINE_CAPTURE=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:win:publish": "npm run build && electron-builder --win --publish always",
    "build:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
